NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api
# Set true only to use bundled sample catalog data when the API is unavailable during development.
NEXT_PUBLIC_USE_MOCK_DATA=false
# How storefronts are addressed (must match the API's STOREFRONT_ROUTING_MODE):
#   path   (default) https://<this site>/vendor/{slug}     no DNS needed
#   domain           https://{slug}.<platform domain> or a verified custom domain
NEXT_PUBLIC_STOREFRONT_MODE=path
# Domain mode only: set to localhost for local *.localhost storefront testing; production uses your platform apex domain.
NEXT_PUBLIC_PLATFORM_DOMAIN=
